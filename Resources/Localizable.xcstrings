        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Schreibmaschine starts because a file is opened, only that file appears. The session before can be brought back under Window → Session. Unsaved texts are always kept, even after a crash."
          }
        }
      }
    },

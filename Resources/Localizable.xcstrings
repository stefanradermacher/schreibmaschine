            "state": "translated",
            "value": "The example scripts go into the scripts folder. Confirm it with “Install”."
          }
        }
      }
    },
    "Die Datei hat unterschiedliche Zeilenenden. Beim Sichern bekommen alle Zeilen %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file has mixed line endings. Saving gives every line %@."

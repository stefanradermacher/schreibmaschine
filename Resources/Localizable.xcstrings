    "Der Text lässt sich nicht als „%@“ sichern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text cannot be saved as “%@”."
          }
        }
      }
    },
    "Die Datei hat unterschiedliche Zeilenenden. Beim Sichern bekommen alle Zeilen %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file has mixed line endings. Saving gives every line %@."
          }
        }
      }
    },
    "Die Datei lässt sich nicht als „%@“ lesen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file cannot be read as “%@”."
          }
        }
      }
    },
    "Die Datei scheint keinen Text zu enthalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file does not seem to contain text."
          }
        }
      }
    },
    "Die Datei wird in der neuen Kodierung neu gelesen. Änderungen seit dem letzten Sichern gehen dabei verloren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is read again in the new encoding. Changes since it was last saved are lost."
          }
        }
      }
    },
    "Die Kodierung der Datei ließ sich nicht erkennen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file’s encoding could not be recognized."
          }
        }
      }
    },
